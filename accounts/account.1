# Account 1 - Bavarian Caps (Local Maildir Mode)
set realname   = "Michael Lang"
set from       = "michi.lang@bavarian-caps.de"
set use_from   = yes

# SMTP for sending mail directly
set smtp_url   = "smtps://michi.lang@bavarian-caps.de@bavarian-caps.de:465"
set smtp_pass  = "`pass show email/michi.lang@bavarian-caps.de`"

# -----------------------------
# Local Maildir Configuration
# -----------------------------
set mbox_type  = Maildir
set folder     = "~/.local/share/mail/michi.lang@bavarian-caps.de"
set spoolfile  = "+INBOX"
set postponed  = "+Drafts"
set record     = "+Sent"
set mbox       = "+Trash"

# -----------------------------
# Mailbox Monitoring
# -----------------------------
unmailboxes *
mailboxes =INBOX =1_TODO =2_DONE =3_ng =4_Design =8_IMPORTANT =9_FIN =Drafts =Sent =Junk =Spam =Trash


# Signature macro
macro compose a1 "<attach-file>~/.config/neomutt/signatures/michi.extern.bc.sig<enter>" "Send to extern"